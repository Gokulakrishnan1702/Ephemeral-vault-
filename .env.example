# ==========================================
# Ephemeral Secret Vault - Environment Config
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173

# Master Cryptographic Encryption Key (AES-256-GCM)
# MUST BE 32 BYTES (64 HEX CHARACTERS or 44 BASE64 CHARACTERS)
# Generate with: node scripts/generate-key.js
VAULT_MASTER_KEY=e4b7c91a3f62804d9c7e2b15a8d46f3c0e9b2a7d5c8e1f4a6b9d2c5e8f1a4b7c

# SQLite Database Storage Location
DATABASE_PATH=./data/vault.db

# Background TTL Garbage Collection Interval (milliseconds)
# Runs periodic hard deletion on expired secrets
SWEEPER_INTERVAL_MS=15000

# Authentication & Session Token Secret
JWT_SECRET=vault_jwt_secret_dev_key_must_be_random_in_production_998877

# Security Options
RATE_LIMIT_MAX_PER_MINUTE=100
ENABLE_BOT_DETECTION=true
